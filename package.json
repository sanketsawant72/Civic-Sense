{
  "name": "civicsense-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:ai": "npm run ai:install && cd ai-service && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:full": "concurrently --names \"frontend,api,ai\" --prefix-colors \"cyan,yellow,magenta\" \"npm run dev\" \"npm run dev:server\" \"npm run dev:ai\"",
    "dev:no-ai": "concurrently --names \"frontend,api\" --prefix-colors \"cyan,yellow\" \"npm run dev\" \"npm run dev:server\"",
    "dev:local": "npm run setup:local && npm run dev:no-ai",
    "setup:local": "node server/setup-local.js",
    "ai:install": "python -m pip install -r ai-service/requirements.txt",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
